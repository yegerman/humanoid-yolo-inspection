<mujoco model="gemini_g1_factory_inspection">
  <include file="../external/unitree_mujoco/unitree_robots/g1/g1_23dof.xml"/>

  <!-- Gravity is disabled for the G1 showcase scene so the humanoid remains
       upright as a visual agent while the demo focuses on language-driven task
       execution. Whole-body balance is intentionally out of scope here. -->
  <option timestep="0.006" gravity="0 0 0"/>

  <visual>
    <global azimuth="135" elevation="-18" offwidth="1280" offheight="960"/>
    <quality shadowsize="2048"/>
    <map force="0.1" zfar="8"/>
    <headlight diffuse="0.35 0.35 0.35" ambient="0.20 0.20 0.22" specular="0.2 0.2 0.2"/>
  </visual>

  <asset>
    <texture name="factory_floor_tex" type="2d" builtin="checker"
             rgb1="0.36 0.36 0.36" rgb2="0.21 0.22 0.23" width="512" height="512"/>
    <material name="factory_floor_mat" texture="factory_floor_tex" texrepeat="10 10" reflectance="0.10"/>
    <material name="factory_table_mat" rgba="0.42 0.44 0.46 1" reflectance="0.12"/>
    <material name="factory_conveyor_mat" rgba="0.06 0.07 0.08 1" reflectance="0.22"/>
    <material name="factory_rail_mat" rgba="0.18 0.20 0.22 1"/>
    <material name="factory_good_mat" rgba="0.10 0.68 0.28 1"/>
    <material name="factory_defect_red_mat" rgba="0.86 0.10 0.08 1"/>
    <material name="factory_defect_dark_mat" rgba="0.16 0.16 0.18 1"/>
    <material name="factory_reject_mat" rgba="0.75 0.12 0.08 1"/>
    <material name="factory_accept_mat" rgba="0.08 0.36 0.78 1"/>
    <material name="factory_gripper_mat" rgba="0.85 0.70 0.28 1"/>
  </asset>

  <worldbody>
    <light name="factory_main_fluorescent" pos="0.8 -0.3 3.2" dir="0 0 -1" diffuse="0.95 0.95 0.9" castshadow="true"/>
    <light name="factory_side_fill" pos="-1.3 -1.7 2.0" dir="1 1 -1" diffuse="0.35 0.38 0.42"/>
    <geom name="factory_floor" type="plane" size="5 5 0.1" material="factory_floor_mat"/>

    <!-- Inspection table placed in front of the G1 humanoid. -->
    <body name="workcell" pos="1.35 0 0">
      <geom name="table_top" type="box" size="0.75 0.55 0.035" pos="0 0 0.75" material="factory_table_mat"/>
      <geom name="conveyor_strip" type="box" size="0.62 0.17 0.012" pos="-0.05 0 0.795" material="factory_conveyor_mat"/>
      <geom name="rail_left" type="box" size="0.62 0.012 0.045" pos="-0.05 0.19 0.835" material="factory_rail_mat"/>
      <geom name="rail_right" type="box" size="0.62 0.012 0.045" pos="-0.05 -0.19 0.835" material="factory_rail_mat"/>
      <geom name="leg_fl" type="box" size="0.035 0.035 0.36" pos="-0.66 -0.46 0.36" material="factory_rail_mat"/>
      <geom name="leg_fr" type="box" size="0.035 0.035 0.36" pos="-0.66 0.46 0.36" material="factory_rail_mat"/>
      <geom name="leg_bl" type="box" size="0.035 0.035 0.36" pos="0.66 -0.46 0.36" material="factory_rail_mat"/>
      <geom name="leg_br" type="box" size="0.035 0.035 0.36" pos="0.66 0.46 0.36" material="factory_rail_mat"/>
    </body>

    <body name="reject_bin" pos="2.25 0.55 0.0">
      <geom name="reject_base" type="box" size="0.24 0.18 0.03" pos="0 0 0.76" material="factory_reject_mat"/>
      <geom type="box" size="0.025 0.18 0.12" pos="-0.22 0 0.88" material="factory_reject_mat"/>
      <geom type="box" size="0.025 0.18 0.12" pos="0.22 0 0.88" material="factory_reject_mat"/>
      <geom type="box" size="0.24 0.025 0.12" pos="0 -0.16 0.88" material="factory_reject_mat"/>
      <geom type="box" size="0.24 0.025 0.12" pos="0 0.16 0.88" material="factory_reject_mat"/>
    </body>
    <body name="good_bin" pos="2.25 -0.55 0.0">
      <geom name="good_base" type="box" size="0.24 0.18 0.03" pos="0 0 0.76" material="factory_accept_mat"/>
      <geom type="box" size="0.025 0.18 0.12" pos="-0.22 0 0.88" material="factory_accept_mat"/>
      <geom type="box" size="0.025 0.18 0.12" pos="0.22 0 0.88" material="factory_accept_mat"/>
      <geom type="box" size="0.24 0.025 0.12" pos="0 -0.16 0.88" material="factory_accept_mat"/>
      <geom type="box" size="0.24 0.025 0.12" pos="0 0.16 0.88" material="factory_accept_mat"/>
    </body>

    <camera name="factory_cam" pos="-1.15 -2.20 1.65" xyaxes="0.88 -0.47 0 0.25 0.46 0.85" fovy="55"/>

    <body name="gantry_gripper" mocap="true" pos="0.45 0 1.35">
      <geom name="gripper_bar" type="box" size="0.10 0.025 0.025" material="factory_gripper_mat"/>
      <geom name="finger_l" type="box" size="0.018 0.018 0.075" pos="0.065 0.045 -0.075" material="factory_gripper_mat"/>
      <geom name="finger_r" type="box" size="0.018 0.018 0.075" pos="0.065 -0.045 -0.075" material="factory_gripper_mat"/>
      <geom name="vertical_tool" type="cylinder" size="0.018 0.13" pos="-0.06 0 0.075" material="factory_rail_mat"/>
    </body>

    <body name="red_part" pos="1.20 0.13 0.86">
      <freejoint name="red_part_free"/>
      <geom name="red_part_geom" type="box" size="0.055 0.055 0.035" material="factory_defect_red_mat" mass="0.05"/>
      <geom name="red_part_marker" type="capsule" fromto="-0.045 -0.045 0.04 0.045 0.045 0.04" size="0.006" rgba="1 1 1 1"/>
    </body>
    <body name="dark_part" pos="1.00 -0.12 0.86">
      <freejoint name="dark_part_free"/>
      <geom name="dark_part_geom" type="box" size="0.055 0.055 0.035" material="factory_defect_dark_mat" mass="0.05"/>
      <geom name="dark_part_marker" type="sphere" size="0.022" pos="0.02 -0.02 0.04" rgba="1 1 1 1"/>
    </body>
    <body name="green_part" pos="1.43 0.02 0.86">
      <freejoint name="green_part_free"/>
      <geom name="green_part_geom" type="box" size="0.055 0.055 0.035" material="factory_good_mat" mass="0.05"/>
    </body>
  </worldbody>
</mujoco>
