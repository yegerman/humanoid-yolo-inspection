<!-- Standalone scene (no G1 MJCF required) for testing scene layout.
     Run: python -m mujoco.viewer --mjcf scene/inspection_scene_standalone.xml -->
<mujoco model="inspection_scene_standalone">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.004" gravity="0 0 -9.81"/>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker"
             rgb1="0.4 0.4 0.4" rgb2="0.3 0.3 0.3" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="8 8" reflectance="0.1"/>
    <material name="table_mat" rgba="0.55 0.45 0.35 1"/>
    <material name="bin_mat" rgba="0.7 0.2 0.1 1"/>
    <material name="part_good" rgba="0.2 0.75 0.2 1"/>
    <material name="part_crack" rgba="0.85 0.1 0.1 1"/>
    <material name="part_discolor" rgba="0.25 0.25 0.25 1"/>

    <!-- Simple robot placeholder (capsule torso + arm) -->
    <material name="robot_body" rgba="0.3 0.3 0.8 1"/>
  </asset>

  <worldbody>
    <light name="light_main" pos="0 0 3" dir="0 0 -1" diffuse="0.9 0.9 0.9" castshadow="true"/>
    <light name="light_fill"  pos="-2 1 2" dir="0.4 -0.2 -1" diffuse="0.3 0.3 0.4"/>

    <geom name="floor" type="plane" size="5 5 0.1" material="floor_mat"/>

    <!-- Work table -->
    <body name="work_table" pos="0.85 0 0">
      <geom name="table_top" type="box" size="0.35 0.25 0.02" pos="0 0 0.76" material="table_mat"/>
      <geom name="table_leg_fl" type="box" size="0.03 0.03 0.37" pos="-0.30 -0.20 0.37"/>
      <geom name="table_leg_fr" type="box" size="0.03 0.03 0.37" pos=" 0.30 -0.20 0.37"/>
      <geom name="table_leg_bl" type="box" size="0.03 0.03 0.37" pos="-0.30  0.20 0.37"/>
      <geom name="table_leg_br" type="box" size="0.03 0.03 0.37" pos=" 0.30  0.20 0.37"/>
    </body>

    <!-- Reject bin -->
    <body name="reject_bin" pos="-0.5 0.7 0">
      <geom type="box" size="0.20 0.15 0.01" pos="0 0 0.05" material="bin_mat"/>
      <geom type="box" size="0.01 0.15 0.08" pos="-0.19 0 0.13" material="bin_mat"/>
      <geom type="box" size="0.01 0.15 0.08" pos=" 0.19 0 0.13" material="bin_mat"/>
      <geom type="box" size="0.20 0.01 0.08" pos="0 -0.14 0.13" material="bin_mat"/>
      <geom type="box" size="0.20 0.01 0.08" pos="0  0.14 0.13" material="bin_mat"/>
    </body>

    <!-- Robot placeholder: torso + head + right arm segments -->
    <body name="robot_base" pos="0 0 0">
      <geom name="torso" type="capsule" fromto="0 0 0.85  0 0 1.25" size="0.09" material="robot_body"/>
      <geom name="head"  type="sphere"  pos="0 0 1.40" size="0.09" material="robot_body"/>

      <!-- Head camera — looking toward table (+X direction, 35° down) -->
      <camera name="head_cam" pos="0 0.09 1.40" xyaxes="0 -1 0 0.574 0 0.819" fovy="75"/>

      <!-- Right arm: shoulder → elbow → wrist -->
      <body name="r_upper_arm" pos="0.15 0 1.20">
        <geom type="capsule" fromto="0 0 0  0.25 0 -0.10" size="0.04" material="robot_body"/>
        <body name="r_forearm" pos="0.25 0 -0.10">
          <geom type="capsule" fromto="0 0 0  0.20 0 -0.10" size="0.03" material="robot_body"/>
          <body name="r_hand" pos="0.20 0 -0.10">
            <geom name="gripper" type="box" size="0.03 0.02 0.02" rgba="0.8 0.6 0.2 1"/>
            <!-- Gripper fingertip site for IK -->
            <site name="r_gripper_site" pos="0.04 0 0"/>
          </body>
        </body>
      </body>
    </body>

    <!-- Inspection parts (3 classes) -->
    <body name="part_0" pos="0.85 0 0.80">
      <freejoint/>
      <geom name="part_0_geom" type="box" size="0.04 0.04 0.025" material="part_good" mass="0.05"/>
    </body>
    <body name="part_1" pos="0.85 0 5.0">
      <freejoint/>
      <geom name="part_1_geom" type="box" size="0.04 0.04 0.025" material="part_crack" mass="0.05"/>
    </body>
    <body name="part_2" pos="0.85 0 5.0">
      <freejoint/>
      <geom name="part_2_geom" type="box" size="0.04 0.04 0.025" material="part_discolor" mass="0.05"/>
    </body>

  </worldbody>
</mujoco>